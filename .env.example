# Which provider is tried first: gemini | groq
# The other one is used automatically as a fallback whenever its key is present
# and the first returns a quota error. Set LLM_FALLBACK=off to disable that.
LLM_PROVIDER=gemini
LLM_FALLBACK=on

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Gemini 3.x only. Thinking tokens come out of the same budget as the document,
# so this is capped: minimal | low | medium | high
GEMINI_THINKING_LEVEL=low

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
